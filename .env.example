# vendor-admins — multi-tenant vendor operations admin (commerce engine)
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# Never commit .env.local. Vars marked "public" are exposed to the browser.

# --- App URLs (public) ---
# AGENTS.md documents this app on :3002. Keep in sync with
# vendor-storefronts/NEXT_PUBLIC_ADMIN_URL and nashemann-admin/VENDOR_PROVISION_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Supabase (commerce project: eznxsosvsgkhexbjoolh) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- Access control ---
# Comma-separated CIDR/IP list allowed to reach the admin surface.
ADMIN_IP_ALLOWLIST=

# --- Internal platform integration ---
NASHEMANN_MAILER_URL=
NASHEMANN_PROVISIONING_SECRET=
VENDOR_PROVISION_SECRET=

# --- Email ---
RESEND_API_KEY=
GMAIL_USER=
# Gmail App Password, not the account password.
GMAIL_APP_PASSWORD=

# --- WhatsApp order notifications (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- AI ---
GROQ_API_KEY=
